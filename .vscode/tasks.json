{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build with MSBuild",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "\"C:/Program Files/Microsoft Visual Studio/18/Community/VC/Auxiliary/Build/vcvarsall.bat\" x64 && msbuild Army.vcxproj /p:Configuration=Debug /p:Platform=x64"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}